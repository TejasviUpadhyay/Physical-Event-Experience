# SmartFlow AI — example environment configuration
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production (Google Cloud Run), set these as environment variables
# in the Cloud Run service configuration or via Secret Manager.
# Never commit a populated .env file to source control.

# ---------------------------------------------------------------------------
# Application identity
# ---------------------------------------------------------------------------
APP_NAME=SmartFlow AI
APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------

# Set to false in production.
DEBUG=false

# URL prefix for all versioned API routes.
API_PREFIX=/api/v1

# Log verbosity. Use INFO in production; DEBUG for local development.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins.
# Leave empty to disable cross-origin access (recommended default).
# Example: ALLOWED_ORIGINS=https://dashboard.example.com,https://ops.example.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Google Gemini AI (Required for AI-powered insights)
# ---------------------------------------------------------------------------

# Google Gemini API key for AI-powered operational insights.
# REQUIRED for production deployment to enable AI features.
# Get your API key from: https://aistudio.google.com/apikey
# 
# IMPORTANT: This uses the NEW google-genai SDK (not the deprecated google-generativeai)
# Model: gemini-flash-latest (stable alias, always points to latest Flash model)
# 
# Example: GEMINI_API_KEY=AIzaSyD...
GEMINI_API_KEY=
